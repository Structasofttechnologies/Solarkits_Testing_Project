# ─────────────────────────────────────────────────────────────────────────────
# SOLARKITS CENTRAL BACKEND — PRODUCTION ENVIRONMENT (.env.production)
# Use this configuration in your Hostinger VPS .env file for LIVE production.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server & Environment ---
PORT=5000
NODE_ENV=production
IPV4=https://api.solarkits.in

# ─── MongoDB Connection (PRODUCTION DATABASE ONLY) ───────────────────────────
# Point this strictly to solarkits_production_db for real customers and orders.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/solarkits_production_db?retryWrites=true&w=majority

# ─── CORS Whitelist ──────────────────────────────────────────────────────────
FRONTEND_URLS=https://admin.solarkits.in,https://solarkits.in,https://store.solarkits.in,https://boskit.solarkits.in

# ─── JWT Authentication ──────────────────────────────────────────────────────
PRIVATE_KEY_PATH=src/keys/private.key
PUBLIC_KEY_PATH=src/keys/public.key
JWT_ACCESS_SECRET=<generate_high_entropy_prod_secret_1>
JWT_REFRESH_SECRET=<generate_high_entropy_prod_secret_2>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=2d
COOKIE_ACCESS_EXPIRY=900000
COOKIE_REFRESH_EXPIRY=172800000
AUTH_JWT_EXPIRES=15m
SET_PASSCODE_JWT_EXPIRES=3m
AUTH_JWT_REFRESH_EXPIRES=2d
AUTH_JWT_ACCESS_EXPIRES=17m

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<prod_cloud_name>
CLOUDINARY_API_KEY=<prod_api_key>
CLOUDINARY_API_SECRET=<prod_api_secret>

# ─── Razorpay (LIVE MODE KEYS) ────────────────────────────────────────────────
RAZORPAY_ID=rzp_live_<your_real_key_id>
RAZORPAY_KEY=<your_real_key_secret>
RAZORPAY_WEBHOOK_SECRET=<your_real_webhook_secret>

# ─── Quick eKYC (PRODUCTION MODE) ─────────────────────────────────────────────
QUICKEKYC_PROVIDER=production
QUICKEKYC_BASE_URL=https://api.quickekyc.in/v1
QUICKEKYC_API_KEY=<your_prod_quickekyc_api_key>
QUICKEKYC_TIMEOUT_MS=10000

