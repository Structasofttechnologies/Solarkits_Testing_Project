# ─────────────────────────────────────────────────────────────────────────────
# SOLARKITS CENTRAL BACKEND — STAGING / TESTING ENVIRONMENT (.env.staging)
# Copy this configuration into Render Environment Variables for the STAGING backend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server & Environment ---
PORT=5000
NODE_ENV=staging
IPV4=https://backend-evwd.onrender.com

# ─── MongoDB Connection (STAGING DATABASE ONLY) ──────────────────────────────
# Point this strictly to solarkits_staging_db. NEVER point to production!
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/solarkits_staging_db?retryWrites=true&w=majority

# ─── CORS Whitelist ──────────────────────────────────────────────────────────
# Include your Render staging admin URL, preview domains, and local test URLs
FRONTEND_URLS=https://backend-evwd.onrender.com,http://localhost:5173,http://localhost:5174,http://localhost:5175,https://test-admin.solarkits.in

# ─── JWT Authentication ──────────────────────────────────────────────────────
PRIVATE_KEY_PATH=src/keys/private.key
PUBLIC_KEY_PATH=src/keys/public.key
JWT_ACCESS_SECRET=staging_jwt_access_secret_test_key_change_me
JWT_REFRESH_SECRET=staging_jwt_refresh_secret_test_key_change_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=2d
COOKIE_ACCESS_EXPIRY=900000
COOKIE_REFRESH_EXPIRY=172800000
AUTH_JWT_EXPIRES=15m
SET_PASSCODE_JWT_EXPIRES=3m
AUTH_JWT_REFRESH_EXPIRES=2d
AUTH_JWT_ACCESS_EXPIRES=17m

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your_cloud_name>
CLOUDINARY_API_KEY=<your_api_key>
CLOUDINARY_API_SECRET=<your_api_secret>

# ─── Razorpay (TEST / SANDBOX MODE ONLY) ──────────────────────────────────────
# IMPORTANT: Use rzp_test_ keys so real bank accounts are NEVER debited during testing!
RAZORPAY_ID=rzp_test_change_to_your_test_key_id
RAZORPAY_KEY=change_to_your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=change_to_your_staging_webhook_secret

# ─── Quick eKYC (MOCK MODE FOR TESTING) ───────────────────────────────────────
QUICKEKYC_PROVIDER=mock
QUICKEKYC_BASE_URL=https://api.quickekyc.in/v1
QUICKEKYC_API_KEY=mock_test_key
QUICKEKYC_TIMEOUT_MS=10000

