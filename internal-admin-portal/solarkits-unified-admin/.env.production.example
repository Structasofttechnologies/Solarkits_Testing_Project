# ============================================================
# SOLARKITS UNIFIED ADMIN PORTAL — PRODUCTION / LIVE (.env.production)
# Set these environment variables on Hostinger VPS (admin.solarkits.in)
# ============================================================
VITE_APP_ENV=production

# --- Auth (shared by all portals) ---
VITE_AUTH_API_URL=https://api.solarkits.in/auth-api
VITE_AUTH_PORTAL_URL=https://admin.solarkits.in/login
VITE_AUTH_TIMEOUT=15m

# --- Admin Panel API ---
VITE_ADMIN_API_URL=https://api.solarkits.in/admin-api
VITE_API_URL=https://api.solarkits.in/admin-api

# --- Accounts Panel API ---
VITE_ACCOUNT_API_URL=https://api.solarkits.in/account-api

# --- Operations Panel API ---
VITE_OPERATION_API_URL=https://api.solarkits.in/operation-management-api

# --- Warehouse Panel API ---
VITE_WAREHOUSE_API_URL=https://api.solarkits.in/warehouse-api

# --- Developer Panel API ---
VITE_DEVELOPER_API_URL=https://api.solarkits.in/developer-api

# --- Supplier API (used by admin) ---
VITE_SUPPLIER_API_URL=https://api.solarkits.in/admin-api/suppliers

# --- Backend Base URL ---
VITE_BACKEND_URL=https://api.solarkits.in

